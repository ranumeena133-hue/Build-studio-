#!/data/data/com.termux/files/usr/bin/bash
# ============================================================
#  bs  =  Build Studio sync
#
#  bs pull    -> GitHub se laakar phone ke folder me daal do
#  bs push    -> phone ka folder GitHub par chadha do
#  bs sync    -> pehle pull phir push (dono ek saath)
#  bs watch   -> background me chalta rahe, apne aap sync kare
#  bs stop    -> background band
#  bs status  -> kya badla hai dikhao
#  bs log     -> background ka log
#  bs config  -> setting badlo
# ============================================================

CONF="$HOME/.buildstudio.conf"
LOG="$HOME/.buildstudio.log"
PIDF="$HOME/.buildstudio.pid"

G='\033[0;32m'; Y='\033[1;33m'; R='\033[0;31m'; B='\033[0;36m'; N='\033[0m'

# log ke sath waqt bhi likho
stamp() { date '+%d-%m-%Y %H:%M:%S'; }
say()  { echo -e "${G}==>$N $1"; echo "[$(stamp)] $1" >> "$LOG"; }
info() { echo -e "${B}  ·${N} $1"; echo "[$(stamp)]   $1" >> "$LOG"; }
warn() { echo -e "${Y}!!${N} $1"; echo "[$(stamp)] ! $1" >> "$LOG"; }
die()  { echo -e "${R}XX${N} $1"; echo "[$(stamp)] X $1" >> "$LOG"; exit 1; }

# ---------- config load ----------
[ -f "$CONF" ] || die "Config nahi mili. Pehle setup.sh chalao."
# shellcheck disable=SC1090
. "$CONF"

: "${WATCH_SECONDS:=30}"
: "${WORK_DIR:=$HOME/buildstudio-work}"

[ -z "$GH_TOKEN" ] && die "Token khaali hai. 'bs config' chalao."
[ -d "$LOCAL_DIR" ] || mkdir -p "$LOCAL_DIR" || die "Phone folder nahi bana: $LOCAL_DIR"

REMOTE="https://${GH_USER}:${GH_TOKEN}@github.com/${GH_USER}/${GH_REPO}.git"

# repo ke andar wala asli rasta
if [ -n "$REPO_SUBDIR" ]; then
    REPO_DIR="$WORK_DIR/$REPO_SUBDIR"
else
    REPO_DIR="$WORK_DIR"
fi

# ---------- folder se folder me copy ----------
# sdcard par permission/time set nahi hote, isliye wo sab band kar diya hai
copy_dir() {
    src="$1"; dst="$2"; mode="${3:-safe}"
    mkdir -p "$dst"

    # mode=mirror -> jo src me nahi hai wo dst se hata bhi do (push ke liye)
    # mode=safe   -> sirf naya/badla hua copy karo, kuch mitao mat (pull ke liye)
    del=""
    [ "$mode" = "mirror" ] && del="--delete"

    if command -v rsync >/dev/null 2>&1; then
        rsync -r --checksum $del \
              --no-perms --no-owner --no-group --omit-dir-times \
              --exclude '.git/' --exclude '.git' \
              --exclude '*.tmp' --exclude '.DS_Store' --exclude 'Thumbs.db' \
              "$src/" "$dst/" 2>/dev/null
    else
        # rsync na ho to haath se copy karo
        cp -r "$src/." "$dst/" 2>/dev/null
        rm -rf "$dst/.git" 2>/dev/null

        # mirror me: jo src me nahi bachi, wo dst se bhi hata do
        if [ "$mode" = "mirror" ]; then
            ( cd "$dst" && find . -type f ! -path './.git/*' 2>/dev/null ) | \
            while read -r f; do
                [ -f "$src/$f" ] || rm -f "$dst/$f" 2>/dev/null
            done
            # khaali reh gaye folder bhi saaf
            find "$dst" -mindepth 1 -type d -empty ! -path "$dst/.git*" -delete 2>/dev/null
        fi
    fi
    return 0
}

# ---------- repo taiyaar karo ----------
prep_repo() {
    if [ ! -d "$WORK_DIR/.git" ]; then
        say "Repo pehli baar clone ho raha hai..."
        rm -rf "$WORK_DIR"
        git clone --branch "$GH_BRANCH" "$REMOTE" "$WORK_DIR" 2>/dev/null \
            || { git clone "$REMOTE" "$WORK_DIR" || die "Clone fail. Token/repo check karo."; \
                 git -C "$WORK_DIR" checkout -B "$GH_BRANCH"; }
    fi
    git -C "$WORK_DIR" remote set-url origin "$REMOTE" 2>/dev/null
    # naam-pata pakka set kar do, warna commit ruk jata hai
    git -C "$WORK_DIR" config user.name  "$GH_USER" 2>/dev/null
    git -C "$WORK_DIR" config user.email "${GH_USER}@users.noreply.github.com" 2>/dev/null
}

# ---------- GitHub se naya maal lao ----------
fetch_latest() {
    git -C "$WORK_DIR" fetch origin "$GH_BRANCH" >/dev/null 2>&1 \
        || { warn "GitHub se baat nahi ho payi (net check karo)"; return 1; }
    # local badlav ko side me rakh kar remote wali copy le lo
    git -C "$WORK_DIR" checkout -B "$GH_BRANCH" "origin/$GH_BRANCH" >/dev/null 2>&1 \
        || git -C "$WORK_DIR" reset --hard "origin/$GH_BRANCH" >/dev/null 2>&1
    return 0
}

# ============================================================
#  KAAM 1 : GitHub  ->  phone
# ============================================================
cmd_pull() {
    say "PULL shuru - GitHub se phone me"
    prep_repo
    fetch_latest || die "Pull ruk gaya."

    if [ ! -d "$REPO_DIR" ]; then
        warn "Repo me '$REPO_SUBDIR' naam ka folder abhi hai hi nahi."
        info "Pehle 'bs push' chalao, ye folder khud ban jayega."
        return 0
    fi

    before=$(find "$LOCAL_DIR" -type f 2>/dev/null | wc -l)
    copy_dir "$REPO_DIR" "$LOCAL_DIR"
    after=$(find "$LOCAL_DIR" -type f 2>/dev/null | wc -l)

    info "Phone folder : $LOCAL_DIR"
    info "Files ab     : $after (pehle $before thi)"
    say "PULL ho gaya."
}

# ============================================================
#  KAAM 2 : phone  ->  GitHub
# ============================================================
cmd_push() {
    say "PUSH shuru - phone se GitHub par"
    prep_repo
    fetch_latest || warn "Naya maal nahi la paye, purani copy par hi kaam kar rahe hain"

    n=$(find "$LOCAL_DIR" -type f 2>/dev/null | wc -l)
    if [ "$n" -eq 0 ]; then
        warn "Phone ka folder khaali hai: $LOCAL_DIR"
        info "Kuch nahi bheja (galti se repo khaali na ho jaye isliye)."
        return 0
    fi

    mkdir -p "$REPO_DIR"
    copy_dir "$LOCAL_DIR" "$REPO_DIR" mirror

    cd "$WORK_DIR" || die "Work folder me nahi ja paye"
    git add -A

    if git diff --cached --quiet 2>/dev/null; then
        info "Kuch naya nahi hai - sab pehle se hi GitHub par hai."
        return 0
    fi

    changed=$(git diff --cached --name-only | wc -l)
    info "$changed file badli hain:"
    git diff --cached --name-status | head -20 | while read -r line; do
        echo "     $line"
    done
    [ "$changed" -gt 20 ] && info "...aur $((changed - 20)) files"

    git commit -q -m "Build Studio sync - $(stamp)" || die "Commit nahi hua"

    if git push -q origin "$GH_BRANCH" 2>/dev/null; then
        say "PUSH ho gaya - $changed file GitHub par chadh gayi."
    else
        warn "Push atak gaya, dobara koshish kar rahe hain..."
        fetch_latest
        copy_dir "$LOCAL_DIR" "$REPO_DIR" mirror
        git add -A
        git diff --cached --quiet || git commit -q -m "Build Studio sync (retry) - $(stamp)"
        git push -q origin "$GH_BRANCH" \
            && say "PUSH ho gaya (doosri koshish me)." \
            || die "Push fail. Token ki 'Contents: Read and write' permission check karo."
    fi
}

# ============================================================
#  Dono ek saath
# ============================================================
cmd_sync() {
    cmd_pull
    echo ""
    cmd_push
}

# ============================================================
#  Background me apne aap
# ============================================================
watch_loop() {
    say "WATCH chalu - har ${WATCH_SECONDS} second me dekhega"
    last=""
    while true; do
        # poore folder ka ek nishaan (fingerprint) banao
        now=$(find "$LOCAL_DIR" -type f -printf '%p %s %T@\n' 2>/dev/null | sort | md5sum | cut -d' ' -f1)

        if [ "$now" != "$last" ] && [ -n "$last" ]; then
            say "Phone me kuch badla hai - GitHub par bhej rahe hain"
            cmd_push
        elif [ -z "$last" ]; then
            info "Pehli baar nishaan banaya, ab nazar rakhenge"
        fi
        last="$now"
        sleep "$WATCH_SECONDS"
    done
}

cmd_watch() {
    if [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF")" 2>/dev/null; then
        warn "Background pehle se chal raha hai (PID $(cat "$PIDF"))"
        info "Band karna ho to: bs stop"
        return 0
    fi
    # phone ko sone se rokna (Termux ka apna kaam)
    command -v termux-wake-lock >/dev/null 2>&1 && termux-wake-lock || true

    nohup "$0" _watchloop >> "$LOG" 2>&1 &
    echo $! > "$PIDF"
    sleep 1
    if kill -0 "$(cat "$PIDF")" 2>/dev/null; then
        say "Background chalu ho gaya (PID $(cat "$PIDF"))"
        info "Har $WATCH_SECONDS second me phone ka folder check hoga"
        info "Log dekhne ke liye : bs log"
        info "Band karne ke liye : bs stop"
    else
        die "Background chalu nahi hua. 'bs log' dekho."
    fi
}

cmd_stop() {
    if [ -f "$PIDF" ]; then
        pid=$(cat "$PIDF")
        if kill "$pid" 2>/dev/null; then
            say "Background band kar diya (PID $pid)"
        else
            warn "Wo pehle hi band tha"
        fi
        rm -f "$PIDF"
    else
        warn "Background chal hi nahi raha tha"
    fi
    command -v termux-wake-unlock >/dev/null 2>&1 && termux-wake-unlock || true
}

# ============================================================
#  Haal-chaal
# ============================================================
cmd_status() {
    echo ""
    echo -e "${B}===== BUILD STUDIO - HAAL =====${N}"
    echo ""
    echo "  GitHub    : $GH_USER/$GH_REPO ($GH_BRANCH)"
    echo "  Repo me   : ${REPO_SUBDIR:-(repo ki jad)}"
    echo "  Phone me  : $LOCAL_DIR"
    echo ""

    if [ -d "$LOCAL_DIR" ]; then
        nf=$(find "$LOCAL_DIR" -type f 2>/dev/null | wc -l)
        sz=$(du -sh "$LOCAL_DIR" 2>/dev/null | cut -f1)
        echo "  Phone folder : $nf files, $sz"
    else
        echo -e "  Phone folder : ${R}mila hi nahi${N}"
    fi

    if [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF")" 2>/dev/null; then
        echo -e "  Background   : ${G}chal raha hai${N} (PID $(cat "$PIDF"))"
    else
        echo -e "  Background   : ${Y}band hai${N}"
    fi
    echo ""

    if [ -d "$WORK_DIR/.git" ]; then
        prep_repo
        fetch_latest >/dev/null 2>&1
        mkdir -p "$REPO_DIR"
        copy_dir "$LOCAL_DIR" "$REPO_DIR" mirror
        cd "$WORK_DIR" || return
        git add -A >/dev/null 2>&1
        d=$(git diff --cached --name-only | wc -l)
        if [ "$d" -eq 0 ]; then
            echo -e "  ${G}Sab barabar hai - kuch bhejne ko nahi.${N}"
        else
            echo -e "  ${Y}$d file GitHub se alag hai:${N}"
            git diff --cached --name-status | head -25 | sed 's/^/     /'
        fi
        git reset -q >/dev/null 2>&1
    fi
    echo ""
}

cmd_log() {
    [ -f "$LOG" ] || { echo "Abhi tak koi log nahi bana."; return; }
    tail -n 60 "$LOG"
}

cmd_config() {
    echo ""
    echo "Abhi ki setting (Enter dabao to wahi rahegi):"
    echo ""
    read -r -p "GitHub username [$GH_USER]: " x; GH_USER="${x:-$GH_USER}"
    read -r -p "Repository [$GH_REPO]: " x; GH_REPO="${x:-$GH_REPO}"
    read -r -p "Branch [$GH_BRANCH]: " x; GH_BRANCH="${x:-$GH_BRANCH}"
    read -r -p "Phone folder [$LOCAL_DIR]: " x; LOCAL_DIR="${x:-$LOCAL_DIR}"
    read -r -p "Repo ke andar folder [$REPO_SUBDIR]: " x; REPO_SUBDIR="${x-$REPO_SUBDIR}"
    read -r -p "Kitne second me check kare [$WATCH_SECONDS]: " x; WATCH_SECONDS="${x:-$WATCH_SECONDS}"
    read -r -s -p "Naya token (Enter = purana hi rahega): " x; echo ""
    [ -n "$x" ] && GH_TOKEN="$x"

    cat > "$CONF" <<EOF
GH_USER="$GH_USER"
GH_REPO="$GH_REPO"
GH_BRANCH="$GH_BRANCH"
GH_TOKEN="$GH_TOKEN"
LOCAL_DIR="$LOCAL_DIR"
REPO_SUBDIR="$REPO_SUBDIR"
WORK_DIR="$WORK_DIR"
WATCH_SECONDS=$WATCH_SECONDS
EOF
    chmod 600 "$CONF"
    mkdir -p "$LOCAL_DIR"
    say "Setting save ho gayi."
}

cmd_help() {
    cat <<'EOF'

  ====== bs - Build Studio sync ======

  bs pull      GitHub se laakar phone ke folder me daal do
  bs push      phone ka folder GitHub par chadha do
  bs sync      pehle pull, phir push

  bs watch     background me chalta rahe (apne aap push karega)
  bs stop      background band karo

  bs status    kya badla hai dekho
  bs log       background ka log
  bs config    setting badlo
  bs help      ye list

  Pehli baar : bs pull
  Roz ka kaam: bs watch  (ek baar chalao, bhool jao)

EOF
}

# ---------- kaunsa kaam ----------
case "${1:-help}" in
    pull)        cmd_pull ;;
    push|up)     cmd_push ;;
    sync)        cmd_sync ;;
    watch|auto)  cmd_watch ;;
    stop)        cmd_stop ;;
    status|st)   cmd_status ;;
    log|logs)    cmd_log ;;
    config|conf) cmd_config ;;
    _watchloop)  watch_loop ;;
    *)           cmd_help ;;
esac
