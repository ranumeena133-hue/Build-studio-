    try:
        subprocess.run(
            ["termux-notification", "--title", "bhai: storage change",
             "--content", f"{rep.ok} ok, {rep.err} err" + (f" · {rep.results[-1]['what'][:60]}" if rep.results else "")],
            capture_output=True, timeout=10,
        )
    except Exception:
