USAGE = __doc__


FLAGS: list[str] = []


def main(argv) -> int:
    global DRY, FLAGS
    args = argv[1:]
    # bare "-" = stdin marker, woh flag nahi hai
    flags = [a for a in args if a.startswith("-") and a != "-"]
    pos = [a for a in args if not a.startswith("-") or a == "-"]
    DRY = "--dry" in flags or "--dry-run" in flags
    FLAGS = flags
    load_cfg()
    ensure_dirs()
    cmd = pos[0] if pos else "sync"
    rest = pos[1:]
    log(f"$ {' '.join(args)}  (dry={DRY})")

    if cmd in ("-h", "--help", "help"):
        print(USAGE)
        return 0
    if cmd in ("version", "--version", "-V"):
        print(f"bhai v{VERSION}  (repo {CFG['REPO_URL']} @ {CFG['BRANCH']})")
        return 0
    if cmd in ("selfupdate", "update"):
        if not have_clone():
            if http_pull():
                print("agent updated (http). Ab:  bhai version")
                return 0
            print("! clone nahi hai, pehle `bhai sync`")
            return 1
        code, out, err = git("fetch", "--quiet", "origin", CFG["BRANCH"])
        git("reset", "--hard", "--quiet", "origin/" + CFG["BRANCH"])
        print("agent updated (repo se). Ab:  bhai version")
        return 0
    if cmd == "pull":
        return 0 if pull() else 1
    if cmd == "push":
        return 0 if push(" ".join(rest) or "phone -> repo via bhai") else 1
    if cmd == "doctor":
        c_doctor()
        return 0
    if cmd == "boot":
        c_boot((rest[0] if rest else "on").lower() != "off")
        return 0
    if cmd == "auth":
        c_auth(rest[0] if rest else None)
        return 0
    if cmd == "config":
        c_config(rest)
        return 0
    if cmd == "uninstall":
        c_uninstall()
        return 0
    if cmd == "hello":
        c_hello()
        return 0
    if cmd == "ls":
        c_ls(rest)
        return 0
    if cmd == "find":
        c_find(rest)
        return 0
    if cmd in ("du", "space"):
        c_du(rest)
        return 0
    if cmd in ("map", "survey"):
        c_map(rest)
        return 0
    if cmd == "up":
        c_up(rest)
        return 0
    if cmd in ("down", "restore"):
        c_down(rest)
        return 0
    if cmd == "report":
        c_report(flags)
        return 0
    if cmd == "log":
        n = int(rest[0]) if rest and rest[0].isdigit() else 40
        if LOG_F.exists():
            print("\n".join(LOG_F.read_text(encoding="utf-8", errors="replace").splitlines()[-n:]))
        else:
            print("(no log)")
        return 0
    if cmd == "run":
        rep = R()
        st = load_state()
        arg = rest[0] if rest else None
        if arg == "-":
            raw = sys.stdin.read()
            if not raw.strip():
                print("usage: bhai run <taskID>   |   cat task.json | bhai run -")
                return 2
            data = json.loads(raw)
            tmp = BHAI / f"stdin-task-{int(time.time())}.json"
            dump_json(tmp, data)
            run_task_file(tmp, rep, st, force="--force" in flags)
            try:
                tmp.unlink()
            except OSError:
                pass
        elif arg:
            n = run_queue(rep, st, only_id=arg, force=True)
            if n == 0:
                print(f"! task {arg} tasks/ me nahi mila. `bhai pull` karo; list: {[f.name for f in task_files()]}")
        else:
            print("usage: bhai run <taskID>   |   echo '<json>' | bhai run -   (--dry pehle dekho)")
            return 2
        if not DRY:
            save_state(st)
            write_report(rep)
        return 0 if rep.err == 0 else 1
    if cmd == "sync":
        rep = R()
        st = load_state()
        if "--force" in flags and not DRY:
            print("! --force: saare tasks DOBARA chalenge (move/rename duplicate kar sakte hain). Ctrl-C for 2 sec...")
            time.sleep(2)
        cmd_sync(rep, st, force="--force" in flags)
        print("\n" + "=" * 58)
        if not rep.results and not DRY:
            print("kuch naya nahi - sab up-to-date. (naya task aaye to main commit karunga)")
        print(f"DONE  {rep.ok} ok · {rep.err} err · {len(rep.results)} step")
        if rep.err:
            print("  error details: `bhai report`")
        if not DRY:
            print("  paste-ready report: `bhai report --copy`")
        return 0
    if cmd == "watch":
        sec = int(rest[0]) if rest and rest[0].isdigit() else int(CFG.get("WATCH_SEC", "30"))
        print(f"watch mode ON (har {sec}s) · Ctrl-C se rok do  · shared={shared()}")
        try:
            while True:
                rep = R()
                st = load_state()
                try:
                    cmd_sync(rep, st)
                except Exception as e:
                    print(f"! loop error: {e}")
                    log("watch: " + traceback.format_exc()[-500:])
                if rep.ok or rep.err:
                    print(f"--- {rep.ok} ok / {rep.err} err ---")
                time.sleep(sec)
        except KeyboardInterrupt:
            print("\nwatch band.")
        return 0
    print(f"unknown command: {cmd}\n")
    print(USAGE[:1600])
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except KeyboardInterrupt:
        sys.exit(130)
