def c_down(args) -> None:
    """Do kaam: (a) manifest ke hisaab se mere edits ORIGINAL phone path par wapas
              (b) storage/ me jo nayi files hain (tumne stage nahi ki) -> inbox folder me."""
    man = load_manifest()
    src_root = repo_sub("storage")
    if not src_root.is_dir():
        print("! repo me storage/ nahi hai abhi. Pehle `bhai sync`.")
        return
    only = {a.lstrip("./") for a in args if not a.startswith("-")}
    applied = 0
    if man:
        print(f"~ tumhari staged files ({len(man)}) ke liye mere edits check kar raha hoon ...")
    for key, entry in sorted(man.items()):
        name = Path(key).name
        if only and not (key in only or name in only):
            continue
        cand = None
        for probe in (src_root / key, src_root / name):
            if probe.is_file():
                cand = probe
                break
        if cand is None:
            cand = find_by_name(src_root, name)
        dst = Path(entry.get("phone_path") or (shared() / key))
        if cand is None:
            print(f"  [--] {key}  (abhi repo/storage me nahi - main edit kar raha hounga to baad me phir `bhai down`)")
            continue
        staged_sha = entry.get("sha256")
        new_sha = sha256_file(cand)
        if new_sha == staged_sha:
            print(f"  [= ] {key}  (mere side se koi badlav nahi, skip)")
            continue
        cur_sha = sha256_file(dst) if dst.is_file() else None
        note = ""
        if cur_sha and staged_sha and cur_sha != staged_sha:
            # phone par file tumne staging ke baad badal di -> overwrite se pehle backup
            bak = TRASH / str(int(time.time())) / (rel_to_shared(dst).replace("/", "__") + ".pre-down.bak")
            if not DRY:
                bak.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(dst, bak)
            note = f"  [phone copy backed up -> {bak.name}]"
        rel = rel_to_shared(dst)
        try:
            detail = cp(cand, dst)
            applied += 1
            if not DRY:
                man[key] = {**entry, "sha256": new_sha, "size": dst.stat().st_size,
                            "mtime": int(dst.stat().st_mtime)}
            print(f"  [ok] {rel}  <- storage/{cand.relative_to(src_root)}  ({detail}){note}")
        except Exception as e:
            print(f"  [err] {key}: {e}")
    if man and applied:
        save_manifest(man)
    # extra files jo main tumhare liye banaya (koi manifest entry nahi)
    extras = []
    for f in sorted(src_root.rglob("*")):
        if not f.is_file() or ".tmp" in f.suffixes:
            continue
        rk = str(f.relative_to(src_root))
        if rk in man or Path(rk).name in {Path(k).name for k in man}:
            continue
        extras.append((rk, f))
    if extras:
        st = load_state()
        seen = st.setdefault("inbox", {})
        inbox = shared() / "Download" / "BuildStudio" / "inbox"
        fresh = []
        for rk, f in extras:
            if seen.get(rk) == sha256_file(f):
                continue
            fresh.append((rk, f))
        if not fresh:
            print(f"· inbox me sab files already padi hain ({len(extras)} checked, koi naya nahi)")
        else:
            print(f"\n~ nayi files jo main tumhare liye banayi ({len(fresh)}) -> {rel_to_shared(inbox)}/")
            for rk, f in fresh:
                try:
                    print(f"  [ok] {rk}  ({cp(f, inbox / rk)})")
                    seen[rk] = sha256_file(f)
                except Exception as e:
                    print(f"  [err] {rk}: {e}")
            if not DRY:
                save_state(st)
    if not man and not extras:
        print("· kuch bhi wapas rakhne jaisa nahi. Flow: `bhai up <file>` -> main edit -> `bhai down`")


