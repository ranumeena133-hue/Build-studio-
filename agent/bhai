DRY = False


def _shared_candidates() -> list[Path]:
    out = []
    for c in (
        Path.home() / "storage" / "shared",
        Path("/storage/emulated/0"),
        Path("/sdcard"),
    ):
        out.append(c)
    return out


def load_cfg() -> None:
    if CFG_F.exists():
        for line in CFG_F.read_text(encoding="utf-8", errors="replace").splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            CFG[k.strip()] = v.strip()
    for k in ("REPO_URL", "BRANCH", "SHARED", "MAX_MB"):
        env = "BHAI_" + k
        if os.environ.get(env):
            CFG[env.split("BHAI_", 1)[1]] = os.environ[env]
    if not CFG.get("SHARED"):
        for c in _shared_candidates():
            if c.exists():
                CFG["SHARED"] = str(c)
                break
        else:
            CFG["SHARED"] = str(_shared_candidates()[0])


def save_cfg() -> None:
    BHAI.mkdir(parents=True, exist_ok=True)
    CFG_F.write_text(
        "\n".join(f"{k}={v}" for k, v in CFG.items()) + "\n", encoding="utf-8"
    )


def shared() -> Path:
    return Path(CFG["SHARED"]).expanduser()


def allow_roots() -> list[Path]:
    roots = [shared(), Path.home(), BHAI, Path("/tmp"), REPO]
    extra = os.environ.get("BHAI_ALLOW", "")
    for e in filter(None, extra.split(os.pathsep)):
        roots.append(Path(e))
    real = []
    for r in roots:
        try:
            real.append(r.resolve())
        except Exception:
            pass
    # /tmp par often symlink -> also keep the unresolved form
    real.append(Path("/tmp"))
    return real


def log(msg: str) -> None:
    try:
        LOGS.mkdir(parents=True, exist_ok=True)
        with LOG_F.open("a", encoding="utf-8") as fh:
            fh.write(f"{datetime.now().isoformat(timespec='seconds')} {msg}\n")
    except Exception:
        pass


# ---------------------------------------------------------------- helpers
def human(n) -> str:
    try:
        n = float(n)
    except Exception:
        return "?"
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return f"{n:.0f}{unit}" if unit == "B" else f"{n:.1f}{unit}"
        n /= 1024
    return f"{n:.1f}TB"


def sha256_file(p: Path, cap: int = 1 << 30) -> str:
    h = hashlib.sha256()
    with p.open("rb") as fh:
        got = 0
        for chunk in iter(lambda: fh.read(1 << 20), b""):
            h.update(chunk)
            got += len(chunk)
            if got >= cap:
                break
    return h.hexdigest()


def is_safe(target: Path) -> tuple[bool, str]:
    """Refuse anything outside the allowed roots (symlink-resolved)."""
    try:
        t = target.resolve()
    except Exception as e:  # noqa
        return False, f"cannot resolve ({e})"
    for root in allow_roots():
        try:
            if t == root or t.relative_to(root):
                return True, ""
        except Exception:
            continue
        # also allow when the *parent* is inside a root and target doesn't exist yet
    return False, f"outside allowed roots ({', '.join(str(r) for r in allow_roots()[:3])})"


def phone_path(raw) -> Path:
    """Task paths are relative to shared storage ('DCIM/Camera/x.jpg')."""
    s = str(raw)
    if s.startswith("~"):
        return Path(s).expanduser()
    if s.startswith("/"):
        return Path(s)
    low = s[2:] if s.startswith("./") else s
    for pre in ("shared/", "/shared/", "sdcard/", "/sdcard/", "storage/emulated/0/", "/storage/emulated/0/"):
        if low.startswith(pre):
            low = low[len(pre):]
            break
    parts = [x for x in low.split("/") if x not in ("", ".")]
    if not parts:
        return shared()
    if ".." in parts:                      # no path-traversal out of shared storage
        raise ValueError("relative path me '..' allowed nahi - shared storage ke andar rakhao")
    return shared().joinpath(*parts)


def repo_sub(name: str) -> Path:
    return REPO / name


def load_json(p: Path, default):
    try:
        return json.loads(p.read_text(encoding="utf-8"))
    except Exception:
        return default


def dump_json(p: Path, data) -> None:
    p.parent.mkdir(parents=True, exist_ok=True)
    tmp = p.with_suffix(p.suffix + ".tmp")
    tmp.write_text(json.dumps(data, indent=1, ensure_ascii=False), encoding="utf-8")
    tmp.replace(p)


def load_state() -> dict:
    st = load_json(STATE_F, {})
    if not isinstance(st, dict):
        st = {}
    st.setdefault("applied", [])
    st.setdefault("inbox", {})
    st.setdefault("last_report", "")
    return st


def save_state(st: dict) -> None:
    dump_json(STATE_F, st)


def load_manifest() -> dict:
    m = load_json(MANIFEST_F, {})
    return m if isinstance(m, dict) else {}


def save_manifest(m: dict) -> None:
    dump_json(MANIFEST_F, m)


def rel_to_shared(p: Path) -> str:
    try:
        return str(Path(p).resolve().relative_to(shared().resolve()))
    except Exception:
        return str(p)


# ---------------------------------------------------------------- git
def git(*args, capture=True, check=False, cwd=None):
    cmd = ["git", "-C", str(cwd or REPO)] + list(args)
    try:
        r = subprocess.run(
            cmd, capture_output=capture, text=True, timeout=180,
            stdin=subprocess.DEVNULL,
        )
    except FileNotFoundError:
        return 127, "", "git nahi mila - `pkg install git -y` chalao"
    except subprocess.TimeoutExpired:
        return 124, "", "git timeout"
    out = (r.stdout or "").strip() if capture else ""
    err = (r.stderr or "").strip() if capture else ""
    if check and r.returncode:
        raise RuntimeError(err or out or f"git {args[0]} failed")
    return r.returncode, out, err


def ensure_dirs() -> None:
    for d in (BHAI, UPLOAD, OUT, TRASH, LOGS):
        d.mkdir(parents=True, exist_ok=True)


def have_clone() -> bool:
    return (REPO / ".git").is_dir()


def pull(quiet=False) -> bool:
    """Always treat the clone as read-only mirror -> hard reset is safe."""
    ensure_dirs()
    if not have_clone():
        REPO.parent.mkdir(parents=True, exist_ok=True)
        if not quiet:
            print("· pehli baar clone kar raha hoon ...")
        code, out, err = git(
            "clone", "--quiet", "--depth", "50", "--single-branch",
            "-b", CFG["BRANCH"], CFG["REPO_URL"], str(REPO), cwd=BHAI)
        if code:
            print(f"! clone fail: {err or out}")
            print("  network/branch check karo: `bhai doctor`")
            return False
    # explicit refspec -> origin/<branch> ref hamesha bane, chahe clone kaise bhi bana ho
    b = CFG["BRANCH"]
    depth = ["--depth", "50"] if (REPO / ".git" / "shallow").exists() else []
    git("config", "remote.origin.fetch", f"+refs/heads/{b}:refs/remotes/origin/{b}")
    code, out, err = git("fetch", "--quiet", *depth, "origin",
                         f"+refs/heads/{b}:refs/remotes/origin/{b}")
    code2, ref, err2 = git("rev-parse", "FETCH_HEAD")
    if code or code2 or not ref:
        print(f"! fetch fail (offline?) : {(err or err2 or out)[:160]}")
        return False
    code, head, _ = git("rev-parse", "HEAD")
    if not code and head == ref:
        if not quiet:
            print(f"· already latest (repo @{ref[:7]}, branch {b})")
        return True
    git("checkout", "--quiet", "-B", b, ref)
    git("reset", "--hard", "--quiet", ref)
    git("clean", "-fdq", "--", "storage", "tasks", "agent")
    if not quiet:
        print(f"· repo @{ref[:7]} (branch {CFG['BRANCH']})")
    return True


def push(msg: str = "phone -> repo via bhai") -> bool:
    ensure_dirs()
    if not shutil.which("git"):
        print("! push ke liye `git` chahiye (`pkg install git`).")
        print("  Filhaal zarurat bhi nahi: chat me file attach kar do ya `bhai report` paste kar do.")
        return False
    if not have_clone():
        print("! clone nahi hai. `bhai sync` pehle.")
        return False
    if not CFG.get("PUSH_URL"):
        print("! push band hai (koi token nahi). Do option:")
        print("   1) `bhai report` ka output copy karke Arena chat me paste karo, ya")
        print("   2) `bhai up <file>` ke baad file ko chat me attach kar do.")
        print("   (chaaho to `bhai auth <token>` se push chalu kar sakte ho - optional)")
        return False
    # stage uploads into the clone
    staged = 0
    for src in sorted(UPLOAD.rglob("*")):
        if src.is_file():
            dst = REPO / "storage" / src.relative_to(UPLOAD)
            dst.parent.mkdir(parents=True, exist_ok=True)
            if not dst.exists() or sha256_file(src) != (
                sha256_file(dst) if dst.exists() else ""
            ):
                shutil.copy2(src, dst)
                staged += 1
    for src in sorted(OUT.glob("*")):
        if src.is_file():
            dst = REPO / "reports" / src.name
            dst.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src, dst)
    git("add", "-A", "storage", "reports")
    code, out, err = git("status", "--porcelain")
    if not out:
        print("· koi naya nahi, push skip.")
        return True
    git("-c", "user.name=bhai-agent", "-c", "user.email=agent@localhost",
        "commit", "-q", "-m", msg)
    git("fetch", "--quiet", "origin", CFG["BRANCH"])
    code, out, err = git("rebase", "--quiet", f"origin/{CFG['BRANCH']}")
    if code:
        git("rebase", "--abort")
        print(f"! rebase conflict, push skip. `bhai sync` karke dobara try karo. ({err[:120]})")
        return False
    code, out, err = git("push", "--quiet", "origin", f"HEAD:{CFG['BRANCH']}")
    if code:
        print(f"! push fail: {(err or out)[:200]}")
        print("  `bhai auth <fine-grained-token>` se token set karo.")
        return False
    print(f"· push ho gaya ({staged} file staged). Ab main dekh lunga.")
    return True


# ---------------------------------------------------------------- task engine
class R:
    """report accumulator"""

    def __init__(self):
        self.lines: list[str] = []
        self.results: list[dict] = []
        self.ok = 0
        self.err = 0
        self.bytes = 0

    def add(self, status, what, detail=""):
        rec = {"status": status, "what": what, "detail": str(detail)[:2000]}
        self.results.append(rec)
        if status == "ok":
            self.ok += 1
        elif status == "err":
            self.err += 1
        line = f"  [{status:>3}] {what}"
        if detail:
            line += f"  -> {str(detail)[:300].replace(chr(10), ' | ')}"
        self.lines.append(line)
        print(line)

    def note(self, text):
        self.lines.append(f"  · {text}")
        print(f"  · {text}")


def _glob_targets(root: Path, pattern: str, budget: int):
    """rglob-ish with a time budget (FUSE storage is slow)."""
    t0 = time.time()
    hits = []
    if pattern.startswith("**/"):
        name_pat = pattern[3:]
        for dirpath, dirnames, filenames in os.walk(root):
            dirnames[:] = [d for d in dirnames if not d.startswith(".")]
            for f in filenames:
                if fnmatch.fnmatch(f, name_pat):
                    hits.append(Path(dirpath) / f)
            if time.time() - t0 > budget:
                hits.append("__TRUNCATED__")
                break
    else:
        try:
            for p in root.glob(pattern):
                if p.is_file():
                    hits.append(p)
                if time.time() - t0 > budget:
                    hits.append("__TRUNCATED__")
                    break
        except Exception:
            pass
    trunc = "__TRUNCATED__" in hits
    return [h for h in hits if h != "__TRUNCATED__"], trunc


def _target_files(op: dict) -> tuple[list[Path], bool]:
    """Concrete file list for an op: from `path`, or `glob`(+`root`)."""
    if op.get("path") or op.get("from") or op.get("file"):
        return [phone_path(op.get("path") or op.get("from") or op.get("file"))], False
    root = phone_path(op.get("root") or "")
    pattern = op.get("glob") or op.get("pattern") or "*"
    hits, trunc = _glob_targets(root, pattern, int(CFG.get("DU_BUDGET", "15")))
    return hits, trunc


# ---- mutation primitives (DRY aware) ----
def w_text(target: Path, text: str, append=False) -> str:
    ok, why = is_safe(target)
    if not ok:
        raise PermissionError(why)
    if DRY:
        return "dry-run (no write)"
    target.parent.mkdir(parents=True, exist_ok=True)
    mode = "a" if append else "w"
    with target.open(mode, encoding="utf-8", newline="") as fh:
        fh.write(text)
    return f"{human(target.stat().st_size)}"


def w_bytes(target: Path, data: bytes) -> str:
    ok, why = is_safe(target)
    if not ok:
        raise PermissionError(why)
    if DRY:
        return "dry-run (no write)"
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_bytes(data)
    return human(len(data))


def rm(target: Path, force=False) -> str:
    ok, why = is_safe(target)
    if not ok:
        raise PermissionError(why)
    if DRY:
        return "dry-run (would delete)"
    if not target.exists():
        return "already gone"
    if force:
        if target.is_dir():
            shutil.rmtree(target)
            return "dir deleted (force)"
        target.unlink()
        return "deleted (force)"
    dest = TRASH / str(int(time.time())) / (rel_to_shared(target).replace("/", "__") or "root")
    dest.parent.mkdir(parents=True, exist_ok=True)
    shutil.move(str(target), str(dest))
    return f"trashed -> {dest}"


def mv(src: Path, dst: Path) -> str:
    for p in (src, dst):
        ok, why = is_safe(p)
        if not ok:
            raise PermissionError(why)
    if DRY:
        return f"dry-run (would move {src.name} -> {dst})"
    dst.parent.mkdir(parents=True, exist_ok=True)
    shutil.move(str(src), str(dst))
    return f"-> {dst}"


def cp(src: Path, dst: Path) -> str:
    for p in (src, dst):
        ok, why = is_safe(p)
        if not ok:
            raise PermissionError(why)
    if DRY:
        return "dry-run (would copy)"
    if not src.exists():
        raise FileNotFoundError(f"source nahi mila: {src}")
    if src.is_dir():
        if dst.exists():
            shutil.rmtree(dst)
        shutil.copytree(src, dst, symlinks=True)
        return "dir copied"
    dst.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(src, dst)
    return human(dst.stat().st_size)


def do_sh(cmd: str, timeout=None) -> str:
    tmo = int(timeout or CFG.get("TIMEOUT", "600"))
    if DRY:
        return "dry-run (would run shell)"
    r = subprocess.run(
        ["bash", "-lc", cmd], capture_output=True, text=True,
        timeout=tmo, cwd=str(Path.home()),
    )
    out = (r.stdout or "") + (("\n[stderr]\n" + r.stderr) if r.stderr else "")
    out = out.strip()
    if len(out) > 8000:
        out = out[:6000] + f"\n...[{len(out)-8000} chars cut]...\n" + out[-1500:]
    if r.returncode:
        raise RuntimeError(f"exit {r.returncode}\n{out[:1200]}")
    return out if out else "ok (no output)"


def name_from_pattern(pat: str, f: Path, i: int) -> str:
    st = f.stat()
    tokens = {
        "{n}": f"{i:04d}",
        "{name}": f.stem,
        "{ext}": f.suffix.lstrip("."),
        "{extd}": f.suffix,
        "{date}": datetime.fromtimestamp(st.st_mtime).strftime("%Y%m%d"),
        "{time}": datetime.fromtimestamp(st.st_mtime).strftime("%H%M%S"),
        "{size}": str(st.st_size),
    }
    out = pat
    for k, v in tokens.items():
        out = out.replace(k, v)
    return out


def apply_step(rep: R, op: dict) -> None:
    kind = (op.get("op") or op.get("do") or "").lower().strip()
    if op.get("skip"):
        rep.add("skip", f"{kind}", op.get("skip"))
        return

    # ---- ops that never touch storage ----
    if kind in ("note", "echo"):
        rep.note(str(op.get("text", "")))
        return
    if kind == "sh":
        cmd = op.get("cmd") or op.get("command") or ""
        if not cmd:
            rep.add("err", "sh", "empty cmd")
            return
        try:
            out = do_sh(cmd, op.get("timeout"))
            rep.add("ok", f"sh `{cmd[:70]}`", out if op.get("show", True) else "(captured)")
        except Exception as e:
            rep.add("err", f"sh `{cmd[:70]}`", e)
        return
    if kind == "up":
        # stage files so the agent (me) can edit them
        paths = op.get("paths") or ([op["path"]] if op.get("path") else [])
        if not paths:
            hits, _ = _target_files(op)
            paths = hits
        for one in paths:
            try:
                n = stage_up(phone_path(one))
                rep.add("ok", f"up `{rel_to_shared(phone_path(one))}`", f"{n} file staged")
            except Exception as e:
                rep.add("err", f"up `{one}`", e)
        return

    # ---- per-target file ops ----
    try:
        targets, truncated = _target_files(op)
    except ValueError as e:
        rep.add("err", kind, f"bad path: {e}")
        return
    if not targets:
        rep.add("warn", f"{kind}", "koi file match nahi hui")
        return
    if len(targets) > 3000 and not op.get("force_many"):
        rep.add("err", kind, f"{len(targets)} files = bahut zyada; 'glob' chhota karo ya force_many:true")
        return

    for i, tgt in enumerate(targets, 1):
        single = dict(op)
        single["path"] = str(tgt)
        label = f"{kind} `{rel_to_shared(tgt)}`"
        try:
            detail = _apply_file_op(kind, single, tgt, i)
            rep.add("ok", label if len(targets) == 1 else f"{label} [{i}/{len(targets)}]", detail)
        except PermissionError as e:
            rep.add("err", label, f"Safety: {e}")
        except Exception as e:
            rep.add("err", label, e)
    if truncated:
        rep.note("glob time-budget se truncate hui (aur files ho sakti hain)")


def _apply_file_op(kind: str, op: dict, tgt: Path, i: int) -> str:
    if kind in ("mkdir", "dir"):
        raw = str(op.get("path") or op.get("from") or "")
        p = tgt if (raw.endswith("/") or tgt.name.endswith("/") or not tgt.suffix) else tgt.parent
        ok, why = is_safe(p)
        if not ok:
            raise PermissionError(why)
        if DRY:
            return "dry-run (would mkdir)"
        p.mkdir(parents=True, exist_ok=True)
        return str(p)

    if kind in ("write", "save", "put"):
        if "content_b64" in op:
            data = base64.b64decode(op["content_b64"])
            return w_bytes(tgt, data)
        text = op.get("content", "")
        if op.get("crlf"):
            text = text.replace("\n", "\r\n")
        return w_text(tgt, str(text))

    if kind in ("append",):
        if DRY and not tgt.exists():
            return "dry-run (abhi file nahi - earlier step banayegi)"
        return w_text(tgt, str(op.get("content", "")), append=True)

    if kind in ("touch",):
        if DRY:
            return "dry-run (would touch)"
        ok, why = is_safe(tgt)
        if not ok:
            raise PermissionError(why)
        tgt.parent.mkdir(parents=True, exist_ok=True)
        tgt.touch(exist_ok=True)
        return "touched"

    if kind in ("replace", "sed", "edit"):
        if not tgt.exists():
            if DRY:
                return "dry-run (abhi file nahi - kisi earlier step banayegi)"
            raise FileNotFoundError(tgt)
        txt = tgt.read_text(encoding=op.get("encoding", "utf-8"), errors="replace")
        find, with_ = str(op.get("find", "")), str(op.get("with", op.get("replace", "")))
        if not find:
            raise ValueError("replace me 'find' chahiye")
        if op.get("regex"):
            new, n = re.subn(find, with_, txt, count=int(op.get("count", 0)))
        elif op.get("lines"):
            # find/with as line numbers: {"find":"7","with":"new line"}
            ls = txt.splitlines()
            idx = int(find) - 1
            if op.get("delete_lines"):
                del ls[idx]
                n = 1
            else:
                ls[idx] = with_
                n = 1
            new = "\n".join(ls) + ("\n" if txt.endswith("\n") else "")
        else:
            n = txt.count(find)
            cnt = int(op.get("count", 0))
            new = txt.replace(find, with_, cnt if cnt else -1)
        if n == 0:
            return "no match (unchanged)"
        if DRY:
            return f"dry-run ({n} replacement)"
        w_text(tgt, new)
        return f"{n} change(s)"

    if kind in ("copy", "cp"):
        if DRY and not tgt.exists():
            return "dry-run (source abhi nahi - earlier step banayegi)"
        dst = phone_path(op["to"])
        if dst.is_dir():                      # dir target -> keep basename
            dst = dst / tgt.name
        return cp(tgt, dst)

    if kind in ("move", "mv"):
        return mv(tgt, phone_path(op["to"]))

    if kind in ("rename",):
        pat = op.get("pattern") or "{name}{extd}"
        new = tgt.parent / name_from_pattern(pat, tgt, i)
        if new == tgt:
            return "same name"
        return mv(tgt, new)

    if kind in ("delete", "rm", "remove"):
        return rm(tgt, bool(op.get("force")))

    if kind in ("extract", "unzip"):
        if DRY:
            return "dry-run (would extract)"
        dest = phone_path(op.get("to") or tgt.with_suffix(""))
        ok, why = is_safe(dest)
        if not ok:
            raise PermissionError(why)
        dest.mkdir(parents=True, exist_ok=True)
        import zipfile
        import tarfile
        name = tgt.name.lower()
        if zipfile.is_zipfile(tgt):
            with zipfile.ZipFile(tgt) as z:
                for m in z.namelist():
                    if m.startswith("..") or m.startswith("/"):
                        continue
                z.extractall(dest)
            return f"unzip -> {dest}"
        if ".tar" in name:
            with tarfile.open(tgt) as t:
                t.extractall(dest, filter="data") if sys.version_info >= (3, 12) else t.extractall(dest)
            return f"untar -> {dest}"
        raise ValueError("sirf .zip / .tar* support hai")

    if kind in ("compress", "zip"):
        if DRY:
            return "dry-run (would zip)"
        dest = phone_path(op.get("to") or (tgt.parent / (tgt.name + ".zip")))
        dest.parent.mkdir(parents=True, exist_ok=True)
        import zipfile
        with zipfile.ZipFile(dest, "w", zipfile.ZIP_DEFLATED) as z:
            if tgt.is_dir():
                for f in tgt.rglob("*"):
                    if f.is_file():
                        z.write(f, f.relative_to(tgt))
            else:
                z.write(tgt, tgt.name)
        return f"{dest} ({human(dest.stat().st_size)})"

    if kind == "link":
        if DRY:
            return "dry-run"
        dst = phone_path(op["to"])
        ok, why = is_safe(dst)
        if not ok:
            raise PermissionError(why)
        dst.parent.mkdir(parents=True, exist_ok=True)
        if dst.is_symlink() or dst.exists():
            dst.unlink()
        os.symlink(str(tgt), str(dst))
        return f"symlink -> {tgt}"

    if kind == "chmod":
        if DRY:
            return "dry-run"
        mode = int(str(op.get("mode", "644")), 8)
        os.chmod(tgt, mode)
        return oct(mode)

    if kind in ("download",):
        # no network needed for the core loop; kept for Termux convenience
        url, dst = op.get("url"), phone_path(op.get("to") or "Download/" + url.rsplit("/", 1)[-1])
        return do_sh(f'curl -LfsS -o {shlex.quote(str(dst))} {shlex.quote(url)} && echo ok', op.get("timeout"))

    raise ValueError(f"unknown op: {kind!r}")


