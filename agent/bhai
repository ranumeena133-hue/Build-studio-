def c_boot(on: bool) -> None:
    d = Path.home() / ".termux" / "boot"
    f = d / "bhai-watch.sh"
    if on:
        d.mkdir(parents=True, exist_ok=True)
        f.write_text("#!/data/data/com.termux/files/usr/bin/bash\ntermux-wake-lock\n"
                     f"sleep 8\nnohup $(command -v bhai || echo {Path(sys.argv[0]).resolve()}) watch >/dev/null 2>&1 &\n",
                     encoding="utf-8")
        f.chmod(0o700)
        print(f"boot script: {f}")
        print("note: app 'Termux:Boot' install karo (F-Droid) taaki reboot ke baad chale")
    else:
        if f.exists():
            f.unlink()
        print("boot script hata diya")


def c_auth(arg: str | None) -> None:
    if not arg or arg.lower() == "off":
        CFG.pop("PUSH_URL", None)
        save_cfg()
        git("remote", "set-url", "origin", CFG["REPO_URL"])
        print("push off. phone->repo ke liye `bhai report` paste karo ya file attach karo.")
        return
    # fine-grained PAT with Contents:write on this repo
    url = f"https://x-access-token:{arg}@github.com/" + CFG["REPO_URL"].split("github.com/", 1)[1]
    CFG["PUSH_URL"] = url
    save_cfg()
    git("remote", "set-url", "origin", url)
    print("push URL set (token sirf phone par ~/.bhai/config me save hua hai). Test: bhai push")


def c_config(args) -> None:
    if not args:
        print(f"# {CFG_F}")
        for k, v in sorted(CFG.items()):
            print(f"  {k}={v}")
        return
    for a in args:
        if "=" in a:
            k, v = a.split("=", 1)
            CFG[k.strip()] = v.strip()
        else:
            print(f"{a}={CFG.get(a, '')}")
    save_cfg()
    print("saved.")


