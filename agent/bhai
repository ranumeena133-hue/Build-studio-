def task_files() -> list[Path]:
    d = repo_sub("tasks")
    if not d.is_dir():
        return []
    return sorted(p for p in d.glob("*.json") if not p.name.startswith("."))


def run_task_file(path: Path, rep: R, st: dict, force=False) -> bool:
    task = load_json(path, None)
    if not isinstance(task, dict):
        rep.add("err", f"task {path.name}", "valid JSON nahi")
        return False
    tid = str(task.get("id") or path.stem)
    if tid in st["applied"] and not force:
        return False
    if DRY:
        rep.note(f"DRY-RUN task {tid}: {task.get('title', '')}")
    else:
        print(f"\n=== task {tid}: {task.get('title', '')} ===")
    steps = task.get("steps") or task.get("ops") or []
    confirm = task.get("confirm")
    if confirm and not DRY:
        ans = input(f"  ! task {tid} ke liye '{confirm}' type karo (ya 'no'): ").strip()
        if ans != confirm:
            rep.add("skip", f"task {tid}", "user cancelled confirm")
            return False
    for op in steps:
        try:
            apply_step(rep, op)
        except Exception as e:
            rep.add("err", f"task {tid}", f"{e}\n{traceback.format_exc()[-400:]}")
    if not DRY:
        st["applied"].append(tid)
        st["applied"] = list(dict.fromkeys(st["applied"]))[-500:]
    if task.get("receipt") is not False and not DRY:
        (OUT / f"receipt-{tid}.json").write_text(
            json.dumps({"task": tid, "at": time.time(), "results": rep.results},
                       indent=1, ensure_ascii=False), encoding="utf-8")
    return True


def run_queue(rep: R, st: dict, only_id=None, force=False) -> int:
    ran = 0
    files = task_files()
    if not files:
        rep.note("tasks/ khali hai - abhi koi instruction nahi")
    for f in files:
        if only_id and only_id not in (f.stem, f.name):
            continue
        if run_task_file(f, rep, st, force):
            ran += 1
        if only_id:
            break
    if only_id and ran == 0 and not force:
        # maybe already applied
        for f in files:
            if only_id in (f.stem, f.name):
                rep.add("skip", f"task {only_id}", "pehle bhi apply ho chuka ('--force' se dobara)")
                ran = -1
    return ran


def stage_up(src: Path) -> int:
    """copy phone file/dir into ~/.bhai/upload preserving shared-relative path."""
    ok, why = is_safe(src)
    if not ok:
        raise PermissionError(why)
    if not src.exists():
        raise FileNotFoundError(f"{src} nahi mila")
    rel = rel_to_shared(src)
    dst = UPLOAD / rel
    maxb = int(float(CFG.get("MAX_MB", "150"))) * 1024 * 1024
    man = load_manifest()
    n = 0
    if src.is_file():
        files = [src]
        droot, sroot = dst.parent, src.parent
    else:
        files = [p for p in sorted(src.rglob("*")) if p.is_file()]
        droot, sroot = dst, src
    dst.parent.mkdir(parents=True, exist_ok=True)
    skipped = []
    for f in files:
        if f.stat().st_size > maxb:
            skipped.append(f"{f.name} ({human(f.stat().st_size)})")
            continue
        t = droot / f.relative_to(sroot) if f != src else dst
        t.parent.mkdir(parents=True, exist_ok=True)
        h = sha256_file(f)
        key = rel_to_shared(f)
        if man.get(key, {}).get("sha256") == h and t.exists():
            continue
        shutil.copy2(f, t)
        man[key] = {
            "sha256": h, "size": f.stat().st_size,
            "mtime": int(f.stat().st_mtime), "phone_path": str(f),
        }
        n += 1
    save_manifest(man)
    if skipped:
        print(f"  · skip (MAX_MB={CFG['MAX_MB']}): {', '.join(skipped[:6])}")
    print(f"  {n} file staged -> {UPLOAD}")
    print("  Ab 2 raaste:")
    print("   A) chat me file attach kar do (Arena use storage/ me rakh deta hai) - main edit kar dunga")
    print("   B) `bhai push` (git + `bhai auth <token>` ho tab) - seedha repo me")
    print("  Mere edit ke baad: `bhai sync && bhai down`")
    return n


# ---------------------------------------------------------------- http sync (git nahi chahiye)
def github_slug():
    m = re.search(r"github\.com[:/]+([^/]+)/([^/]+?)(?:\.git)?/?$", CFG["REPO_URL"])
    return (m.group(1), m.group(2)) if m else None


def _dir_hash(d: Path) -> str:
    h = hashlib.sha256()
    if not d.is_dir():
        return "missing"
    for f in sorted(d.rglob("*")):
        if f.is_file():
            try:
                st = f.stat()
                h.update(f"{f.relative_to(d)}:{st.st_size}".encode())
            except Exception:
                pass
    return h.hexdigest()[:16]


def http_pull(quiet=False) -> bool:
    """Repo ka tarball seedha urllib se - koi git, koi token, koi API nahi."""
    import io
    import tarfile
    import urllib.request
    slug = github_slug()
    if not slug:
        print("! REPO_URL GitHub nahi lag raha - http mode skip. (bhai config REPO_URL=...)")
        return False
    owner, name = slug
    br = CFG["BRANCH"]
    url = f"https://codeload.github.com/{owner}/{name}/tar.gz/refs/heads/{br}"
    if not quiet:
        print(f"~ http pull: {url}")
    try:
        req = urllib.request.Request(url, headers={"User-Agent": f"bhai/{VERSION}"})
        with urllib.request.urlopen(req, timeout=90) as r:
            data = r.read(80 * 1024 * 1024)
    except Exception as e:
        print(f"! http pull fail: {str(e)[:180]}")
        return False
    if len(data) < 200:
        print("! tarball khaali/404 - branch naam check karo")
        return False
    tmp = BHAI / ".http-new"
    shutil.rmtree(tmp, ignore_errors=True)
    tmp.mkdir(parents=True, exist_ok=True)
    try:
        with tarfile.open(fileobj=io.BytesIO(data)) as t:
            names = t.getnames()
            if not names:
                raise ValueError("empty tarball")
            try:
                t.extractall(tmp, filter="data")          # py>=3.11.4
            except TypeError:
                t.extractall(tmp)
    except Exception as e:
        print(f"! tar parse fail: {e}")
        shutil.rmtree(tmp, ignore_errors=True)
        return False
    src = tmp / names[0].split("/")[0]
    REPO.mkdir(parents=True, exist_ok=True)
    changed = []
    for sub in ("agent", "tasks", "storage", "reports"):
        s2, d2 = src / sub, REPO / sub
        if not s2.is_dir():
            continue
        if _dir_hash(d2) != _dir_hash(s2):
            shutil.rmtree(d2, ignore_errors=True)
            d2.parent.mkdir(parents=True, exist_ok=True)
            shutil.copytree(s2, d2, symlinks=True)
            changed.append(sub)
    shutil.rmtree(tmp, ignore_errors=True)
    if not quiet:
        print(f"· http sync done - badla: {', '.join(changed) if changed else 'kuch naya nahi'}")
    return True


def sync_from_remote(quiet=False) -> bool:
    """SYNC_MODE=auto: git ho to git (push bhi possible), warna/fail par http tarball."""
    mode = CFG.get("SYNC_MODE", "auto")
    if mode == "http":
        return http_pull(quiet)
    if pull(quiet=quiet):
        return True
    if mode == "git":
        return False
    print("! git pull fail -> http mode try kar raha hoon ...")
    return http_pull(quiet)


def find_by_name(root: Path, name: str):
    direct = root / name
    if direct.is_file():
        return direct
    try:
        for p in root.rglob(name):
            if p.is_file():
                return p
    except Exception:
        pass
    return None


def cmd_sync(rep: R, st: dict, only=None, force=False, no_pull=False) -> None:
    if not no_pull:
        if not sync_from_remote():
            rep.note("pull fail (offline?) - jo tasks pehle se hain unpar chalata hoon")
    ran = run_queue(rep, st, only_id=only, force=force)
    if ran > 0:
        save_state(st)
        notify(rep)
    if not DRY:
        st["last_report"] = write_report(rep)


def write_report(rep: R, keep_if_empty=True) -> str:
    if keep_if_empty and not rep.results:
        prev = OUT / "latest.txt"
        return prev.read_text(encoding="utf-8") if prev.exists() else ""
    head = [
        f"bhai report v{VERSION}  ·  {datetime.now().isoformat(timespec='seconds')}",
        f"device: {os.environ.get('TERMUX_APP_PACKAGE', 'termux')} · android: "
        f"{os.popen('getprop ro.build.version.release 2>/dev/null').read().strip() or '?'}",
        f"shared: {shared()} · dry={DRY}",
    ]
    body = rep.lines
    tail = [f"summary: {rep.ok} ok · {rep.err} err"]
    txt = "\n".join(head + body + tail)
    OUT.mkdir(parents=True, exist_ok=True)
    (OUT / "latest.txt").write_text(txt + "\n", encoding="utf-8")
    (OUT / f"report-{int(time.time())}.txt").write_text(txt + "\n", encoding="utf-8")
    (OUT / "report.json").write_text(
        json.dumps({"at": time.time(), "ok": rep.ok, "err": rep.err,
                    "results": rep.results}, indent=1, ensure_ascii=False) + "\n",
        encoding="utf-8")
    return txt


def notify(rep: R) -> None:
