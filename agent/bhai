def c_du(args) -> None:
    root = phone_path(args[0]) if args else shared()
    budget = int(CFG.get("DU_BUDGET", "15"))
    t0 = time.time()
    tot = 0
    files = 0
    big: list[tuple[int, Path]] = []
    subs: dict[str, int] = {}
    truncated = False
    minbig = 25 * 1024 * 1024
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if not d.startswith(".")]
        top = os.path.relpath(dirpath, root).split(os.sep)[0]
        for f in filenames:
            fp = os.path.join(dirpath, f)
            try:
                sz = os.stat(fp).st_size
            except Exception:
                continue
            tot += sz
            files += 1
            if top != ".":
                subs[top] = subs.get(top, 0) + sz
            if sz >= minbig:
                big.append((sz, Path(fp)))
            if time.time() - t0 > budget:
                truncated = True
                break
        if truncated:
            break
    print(f"root: {root}   scanned: {human(tot)} in {files} files  "
          f"({'TIME-OUT partial' if truncated else 'complete'})")
    try:
        st = os.statvfs(str(root))
        free = st.f_bavail * st.f_frsize
        print(f"free on volume: {human(free)} of {human(st.f_blocks * st.f_frsize)}")
    except Exception:
        pass
    if subs:
        print("\ntop-level folders:")
        for k, v in sorted(subs.items(), key=lambda x: -x[1])[:20]:
            print(f"  {human(v):>9}  {k}")
    if big:
        print("\nlargest files (>=25MB):")
        for sz, p in sorted(big, reverse=True)[:15]:
            print(f"  {human(sz):>9}  {rel_to_shared(p)}")


