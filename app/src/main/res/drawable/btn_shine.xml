<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#0097A7"
                android:endColor="#006064"
                android:angle="135" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#00E5FF"
                android:centerColor="#00BCD4"
                android:endColor="#0097A7"
                android:angle="135" />
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="#80DEEA" />
        </shape>
    </item>
</selector>